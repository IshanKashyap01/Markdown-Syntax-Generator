<project 
xmlns="http://maven.apache.org/POM/4.0.0"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
>
    <modelVersion>4.0.0</modelVersion>
    
    <!-- Parent GAV -->
    <parent>
        <groupId>io.github.ishankashyap01</groupId>
        <artifactId>super-parent-pom</artifactId>
        <version>1.0.1</version>
    </parent>

    <!-- Project GAV -->

    <groupId>io.github.ishankashyap01</groupId>
    <artifactId>markdown-syntax-generator</artifactId>
    <version>1.0.0</version>

    <!-- Project Information -->

    <name>Markdown Syntax Generator</name>
    <description>A Java library for generating Markdown syntax</description>
    <url>https://github.com/IshanKashyap01/Markdown-Syntax-Generator</url>

    <scm>
        <connection>scm:git:https://github.com/IshanKashyap01/Markdown-Syntax-Generator.git</connection>
        <developerConnection>scm:git:git@github.com:IshanKashyap01/Markdown-Syntax-Generator.git</developerConnection>
        <url>https://github.com/IshanKashyap01/Markdown-Syntax-Generator</url>
        <tag>HEAD</tag>
    </scm>

    <!-- String.repeat() that isn't supported by versions before 11 -->

    <properties>
        <maven.compiler.release>11</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <reporting>
        <plugins>
            <plugin>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
            <plugin>
                <artifactId>maven-javadoc-plugin</artifactId>
                <!-- skip tests and generate Java docs only for main code -->
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>javadoc</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>
        </plugins>
    </reporting>
</project>